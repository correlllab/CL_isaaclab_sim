{
    "ClRos2LivoxPy": {
        "version": 1,
        "language": "python",
        "icon": "icons/icon.svg",
        "uiName": "OgnClRos2LivoxPy",
        "description": [
            "The description key value is required on all nodes and will be used in the generated documentation of the node.",
            "Visit https://docs.omniverse.nvidia.com/kit/docs/omni.graph.docs/latest/dev/ogn/ogn_reference_guide.html",
            "for a detailed guide to the syntax of the .ogn file.",
            "Visit https://docs.omniverse.nvidia.com/kit/docs/omni.graph.docs/latest/dev/ogn/attribute_types.html",
            "for more details about the supported attribute data types for inputs and outputs."
        ],
        "categoryDefinitions": "config/CategoryDefinition.json",
        "categories": ["extension:Category"],
        "inputs": {
            "execution": {
                "type": "execution",
                "uiName": "execution",
                "description": "execution"
            },
            "pos_w": {
                "type": "float[3]",
                "uiName": "pos_w",
                "description": "pos_w"
            },
            "quat_w": {
                "type": "quatf[4]",
                "uiName": "quat_w",
                "description": "quat_w"
            },
            "projected_gravity_b": {
                "type": "float[3]",
                "uiName": "projected_gravity_b",
                "description": "projected_gravity_b"
            },
            "lin_vel_b": {
                "type": "float[3]",
                "uiName": "lin_vel_b",
                "description": "lin_vel_b"
            },
            "lin_acc_b": {
                "type": "float[3]",
                "uiName": "lin_acc_b",
                "description": "lin_acc_b"
            },
            "ang_vel_b": {
                "type": "float[3]",
                "uiName": "ang_vel_b",
                "description": "ang_vel_b"
            },
            "ang_acc_b": {
                "type": "float[3]",
                "uiName": "ang_acc_b",
                "description": "ang_acc_b"
            }
        }
    }
}
