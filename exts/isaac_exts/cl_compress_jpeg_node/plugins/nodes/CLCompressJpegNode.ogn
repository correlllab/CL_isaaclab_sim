
{
  "CLCompressJpegNode": {
    "version": 1,
    "uiName": "CL Compress RGB8 to Jpeg Node",
    "description": [
      "Node by Mateo Feit that takes in the data buffer from a render product (that has been annotated by an image annotator) and compresses the rgb8 data to jpeg so that it can be published as a compressedimage msg."
    ],
    "categories": ["math:conversion"],
    "inputs": {
      "input_buffer": {
        "type": "float[]",
        "uiName": "input_buffer",
        "description": "buffer for input rgb8 image data"
      }
    },
    "outputs": {
    "output_buffer": {
      "type": "float[]",
      "uiName": "output_buffer",
      "description": "buffer for output compressed image data"
      }
    }
  }
}
